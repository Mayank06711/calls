# ══════════════════════════════════════════════════════════
#  KYF Fashion — Production Environment Variables
#  Copy to .env and fill in real values
# ══════════════════════════════════════════════════════════

# ── MongoDB (Atlas free tier) ──
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# ── Redis ──
REDIS_USERNAME=kyf_user
REDIS_PASSWORD=change_me_strong_password

# ── Internal Service Auth ──
# Shared secret between Node.js server and Python AI service
INTERNAL_SERVICE_KEY=change_me_random_string_64_chars

# ── Cloudinary ──
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET_KEY=your_api_secret

# ── JWT Secrets (generate unique random strings) ──
ACCESS_TOKEN_SECRET=change_me
ACCESS_TOKEN_SECRET_EXPIRY=15min
REFRESH_TOKEN_SECRET=change_me
REFRESH_TOKEN_SECRET_EXPIRY=15d
ADMIN_ACCESS_TOKEN_SECRET=change_me
ADMIN_ACCESS_TOKEN_EXPIRY=30min
ADMIN_REFRESH_TOKEN_SECRET=change_me
ADMIN_REFRESH_TOKEN_EXPIRY=1h
ENCRYPTION_SECRET=change_me

# ── Email (Mailtrap / SMTP) ──
MAIN_EMAIL=your@email.com
EMAIL_USERNAME=smtp_user
EMAIL_USERNAME_PASSWORD=smtp_pass
EMAIL_HOSTNAME=smtp.mailtrap.io
EMAIL_PORT=2525

# ── SMS (Twilio) ──
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_SMS_NUMBER=+1234567890

# ── Client ──
CLIENT_URL=http://your-domain.com
VITE_API_URL=http://your-domain.com:5005

# ── Python AI Service (only needed if deployed separately) ──
# PYTHON_SERVICE_URL=http://python-ai-host:8001
